# URL ที่เปิดเว็บในเบราว์เซอร์ (dev = Vite, prod = โดเมน Vercel)
PUBLIC_URL=http://localhost:5173
PORT=3001

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# อีเมล Google ที่อนุญาตให้ login (คั่นด้วย , ถ้ามีหลายอัน)
ALLOWED_EMAILS=

# Supabase > Project Settings > API (ใช้ service_role / secret key ห้ามใส่ใน frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# สุ่มค่ายาวๆ สองค่า เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
TOKEN_ENC_KEY=

# ประเทศที่ใช้ดึงรายการหมวดหมู่ของ YouTube
REGION_CODE=TH
